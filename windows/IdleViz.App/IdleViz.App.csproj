<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- Windows 11 only: 22000 is its first build. -->
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>IdleViz.App</RootNamespace>
    <AssemblyName>IdleViz</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\IdleViz.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged and self-contained: the installer copies a folder that needs nothing else on the PC. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Without this, publish leaves out the compiled XAML (IdleViz.pri and the .xbf files), and every window fails to open. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Program.cs has the entry point: it hands over to a copy that is already running before any UI starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- The Win32 calls CsWin32 generates use pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <!-- The on-device AI parts of the Windows App SDK, which the app never calls. Named here only to
         keep them out of the app folder: about 50 MB, most of it onnxruntime.dll and DirectML.dll.
         Their versions in Directory.Packages.props are the ones Microsoft.WindowsAppSDK asks for. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IdleViz.Core\IdleViz.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\IdleViz.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- The page, shared with the Mac app. It is served from the "web" folder next to the exe. -->
    <Content Include="..\..\IdleViz\web\**\*" Link="web\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- WinUI brings its own texts (the names screen readers say for controls, the text box menu) in
       86 languages, one folder each. The app is in English only, so only en-us is kept. -->
  <Target Name="KeepOnlyEnglishWinUITexts" BeforeTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents" DependsOnTargets="GetWindowsAppSDKNativePlatform">
    <ItemGroup>
      <MicrosoftWindowsAppSDKFilesExcluded Include="%(WindowsAppSdkComponentPackages.Identity)runtimes-framework\win-$(NativePlatform)\native\**\*.mui" Exclude="%(WindowsAppSdkComponentPackages.Identity)runtimes-framework\win-$(NativePlatform)\native\en-us\*.mui" />
    </ItemGroup>
  </Target>

</Project>
