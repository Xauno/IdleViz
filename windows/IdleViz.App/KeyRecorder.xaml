<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="IdleViz.App.KeyRecorder"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Orientation="Horizontal" Spacing="4">
    <Button
      x:Name="RecordButton"
      MinWidth="120"
      Click="OnRecordClick"
      LostFocus="OnRecordLostFocus"
      PreviewKeyDown="OnRecordKeyDown"
      ToolTipService.ToolTip="Click, then press a key. Esc keeps the key it had." />
    <Button
      x:Name="ClearButton"
      Padding="8,5"
      Click="OnClearClick"
      ToolTipService.ToolTip="Turn off">
      <FontIcon FontSize="12" Glyph="&#xE711;" />
    </Button>
  </StackPanel>
</UserControl>
