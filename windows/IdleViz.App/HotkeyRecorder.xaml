<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="IdleViz.App.HotkeyRecorder"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Orientation="Horizontal" Spacing="4">
    <Button
      x:Name="RecordButton"
      MinWidth="120"
      Click="OnRecordClick"
      LostFocus="OnRecordLostFocus"
      PreviewKeyDown="OnRecordKeyDown"
      PreviewKeyUp="OnRecordKeyUp"
      ToolTipService.ToolTip="Click, then press a key together with Ctrl, Alt, Shift or the Windows key" />
    <Button
      x:Name="ClearButton"
      Padding="8,5"
      AutomationProperties.Name="Clear hotkey"
      Click="OnClearClick"
      ToolTipService.ToolTip="Clear">
      <FontIcon FontSize="12" Glyph="&#xE711;" />
    </Button>
  </StackPanel>
</UserControl>
