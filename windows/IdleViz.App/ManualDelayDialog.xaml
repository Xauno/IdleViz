<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
  x:Class="IdleViz.App.ManualDelayDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Manual delay test"
  CloseButtonText="Done"
  DefaultButton="Close">

  <StackPanel Width="320" Spacing="12">
    <!-- Dark between flashes, white for a beep and orange for the marked one. Fixed colours, so the
         flash reads the same in light and dark mode. -->
    <Border
      x:Name="FlashPanel"
      Height="96"
      Background="Black"
      CornerRadius="4" />

    <TextBlock
      x:Name="ProblemText"
      Foreground="{ThemeResource SystemFillColorCriticalBrush}"
      TextWrapping="Wrap"
      Visibility="Collapsed" />

    <TextBlock
      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
      Text="Drag until the panel lights up exactly when you hear the beep. Every fourth beep is higher, and its flash is orange."
      TextWrapping="Wrap" />

    <Grid ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Click="OnEarlierClick" Content="&#x2212;10 ms" />
      <Slider
        x:Name="DelaySlider"
        Grid.Column="1"
        VerticalAlignment="Center"
        AutomationProperties.Name="Audio delay"
        IsThumbToolTipEnabled="False"
        LargeChange="0.1"
        Maximum="2.5"
        Minimum="0"
        SmallChange="0.01"
        StepFrequency="0.01"
        ValueChanged="OnDelayChanged" />
      <Button Grid.Column="2" Click="OnLaterClick" Content="+10 ms" />
    </Grid>

    <Grid ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock
        x:Name="DeviceText"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        MaxLines="1"
        Style="{StaticResource CaptionTextBlockStyle}"
        TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="DelayText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" />
    </Grid>
  </StackPanel>
</ContentDialog>
