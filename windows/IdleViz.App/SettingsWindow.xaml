<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="IdleViz.App.SettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:CommunityToolkit.WinUI.Controls"
  xmlns:local="using:IdleViz.App">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- The title bar is drawn here so the Mica background runs to the top edge. Windows adds the buttons. -->
    <Grid x:Name="TitleBar">
      <TextBlock
        Margin="12,0,0,0"
        VerticalAlignment="Center"
        Style="{StaticResource CaptionTextBlockStyle}"
        Text="IdleViz Settings" />
    </Grid>

    <ScrollViewer Grid.Row="1" Padding="16,0,16,0">
      <StackPanel Margin="0,0,0,16" Spacing="3">
        <StackPanel.Resources>
          <!-- Settings cards stack their control under the label below these widths. The defaults are
               wider than this window, which would stack every row. -->
          <x:Double x:Key="SettingsCardWrapThreshold">300</x:Double>
          <x:Double x:Key="SettingsCardWrapNoIconThreshold">200</x:Double>
        </StackPanel.Resources>
        <TextBlock Margin="0,6,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" Text="General" />

        <controls:SettingsCard x:Name="HotkeyCard" Header="Open hotkey">
          <local:HotkeyRecorder x:Name="Recorder" />
        </controls:SettingsCard>

        <controls:SettingsCard Header="Open now">
          <Button Click="OnOpenNowClick" Content="Open" />
        </controls:SettingsCard>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
