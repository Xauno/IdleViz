<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="IdleViz.App.SettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:CommunityToolkit.WinUI.Controls"
  xmlns:local="using:IdleViz.App">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- The title bar is drawn here so the Mica background runs to the top edge. Windows adds the buttons. -->
    <Grid x:Name="TitleBar">
      <TextBlock
        Margin="12,0,0,0"
        VerticalAlignment="Center"
        Style="{StaticResource CaptionTextBlockStyle}"
        Text="IdleViz Settings" />
    </Grid>

    <ScrollViewer Grid.Row="1" Padding="16,0,16,0">
      <StackPanel Margin="0,0,0,16" Spacing="3">
        <StackPanel.Resources>
          <!-- Settings cards stack their control under the label below these widths. The defaults are
               wider than this window, which would stack every row. -->
          <x:Double x:Key="SettingsCardWrapThreshold">300</x:Double>
          <x:Double x:Key="SettingsCardWrapNoIconThreshold">200</x:Double>
        </StackPanel.Resources>
        <TextBlock Margin="0,6,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" Text="General" />

        <controls:SettingsCard Description="Needs a Spotify track" Header="Start after idle">
          <ComboBox x:Name="IdlePicker" MinWidth="110" SelectionChanged="OnIdleChanged" />
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="HotkeyCard" Header="Open hotkey">
          <local:HotkeyRecorder x:Name="Recorder" />
        </controls:SettingsCard>

        <controls:SettingsCard Header="Open now">
          <Button Click="OnOpenNowClick" Content="Open" />
        </controls:SettingsCard>

        <TextBlock Margin="0,18,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Visualizer" />

        <controls:SettingsCard Header="Mode">
          <ComboBox x:Name="ModePicker" MinWidth="110" SelectionChanged="OnModeChanged" />
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="ShuffleFromCard" Header="Shuffle from">
          <ComboBox x:Name="ShuffleFromPicker" MinWidth="110" SelectionChanged="OnShuffleFromChanged" />
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="SecondsCard" Header="Seconds per preset">
          <ComboBox x:Name="SecondsPicker" MinWidth="110" SelectionChanged="OnSecondsChanged" />
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="BlendCard" Header="Blend time">
          <ComboBox x:Name="BlendPicker" MinWidth="110" SelectionChanged="OnBlendChanged" />
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="SingleCard" Header="Visualizer">
          <!-- Preset names are long; a fixed width keeps the row from wrapping, and the box trims them. -->
          <ComboBox x:Name="SinglePicker" Width="200" SelectionChanged="OnSingleChanged" />
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="LastShownCard" Header="Last shown">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <ToggleButton x:Name="FavoriteButton" Click="OnFavoriteClick">
              <FontIcon x:Name="FavoriteIcon" FontSize="14" Glyph="&#xE006;" />
            </ToggleButton>
            <ToggleButton x:Name="BlockButton" Click="OnBlockClick">
              <FontIcon FontSize="14" Glyph="&#xE733;" />
            </ToggleButton>
          </StackPanel>
        </controls:SettingsCard>

        <controls:SettingsCard Header="Favorites">
          <Button x:Name="FavoritesButton" Click="OnFavoritesClick" />
        </controls:SettingsCard>

        <controls:SettingsCard Header="Blocklist">
          <Button x:Name="BlocklistButton" Click="OnBlocklistClick" />
        </controls:SettingsCard>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
